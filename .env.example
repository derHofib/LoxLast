# LastPlan-Gateway – Beispielkonfiguration. Kopieren nach .env (wird nicht eingecheckt).

# Pflicht im Profil „server“, optional im Profil „local“ (dort wird sonst eine Schlüsseldatei angelegt).
# Erzeugen: openssl rand -hex 32   – Verlust des Schlüssels = gespeicherte Zugangsdaten unlesbar.
GATEWAY_SECRET_KEY=

# Genaue Origins der Web-App, kommagetrennt, ohne Pfad und ohne „*“.
# Pflicht im Profil „server“. Lokal Standard: http://localhost:5173,http://127.0.0.1:5173
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173

# Profil „server“: Interface für das Port-Mapping. 127.0.0.1 = nur hinter Reverse-Proxy auf demselben Host.
# GATEWAY_BIND=127.0.0.1

# Optional (Standardwerte): Token-Laufzeit und Gültigkeit des Kopplungscodes in Minuten.
# GATEWAY_TOKEN_TTL_MIN=60
# GATEWAY_PAIRING_CODE_TTL_MIN=10

# Optional: Ordner mit den Wallbox-Modelldateien (<hersteller>/<modell>@<version>.json) für den
# Geräte-Verbindungstest. Standard: packages/wallbox-library/models im Repo, im Docker-Image /app/library.
# GATEWAY_LIBRARY_DIR=

# Optional: Adresse des „LOXONE Config“-MCP für die Übergabe an Config (ADR 0013). Nur 127.0.0.1,
# localhost oder [::1]; das Gateway läuft dafür auf demselben Windows-System wie Config.
# Die vollständige Adresse (mit Pfad) steht im Plugin-Manifest von „Config MCP“.
# CONFIG_MCP_URL=
