{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/derHofib/LoxLast/packages/wallbox-library/schema/wallbox-model.schema.json",
  "title": "LastPlan Wallbox-Modell",
  "description": "Eine Datei je Modell und Version: models/<hersteller>/<modell>@<version>.json. Werte sind echte Werte oder ein TODO-Platzhalter (Text, der mit TODO beginnt). Jeder Block mit Quelle (source) darf nur dann echte Werte enthalten, wenn source auf eine Herstellerunterlage zeigt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "vendor", "model", "firmware", "protocols", "electrical", "modbus", "loxone"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]*$"
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "firmware": {
      "$ref": "#/$defs/firmware"
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["modbus-tcp", "http", "ocpp-bridge"]
      }
    },
    "electrical": {
      "$ref": "#/$defs/electrical"
    },
    "modbus": {
      "$ref": "#/$defs/modbus"
    },
    "loxone": {
      "$ref": "#/$defs/loxone"
    }
  },
  "$defs": {
    "todo": {
      "type": "string",
      "pattern": "^\\s*[Tt][Oo][Dd][Oo]"
    },
    "source": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^\\s*[Tt][Oo][Dd][Oo]"
          },
          "pattern": "\\S"
        },
        {
          "$ref": "#/$defs/todo"
        }
      ]
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "source"],
      "properties": {
        "min": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "electrical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minA", "maxA", "phases", "phaseSwitching", "source"],
      "properties": {
        "minA": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "maxA": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "phases": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [1, 3]
              }
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "phaseSwitching": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "modbus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultPort", "defaultUnitId", "byteOrder", "registers", "source"],
      "properties": {
        "defaultPort": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "defaultUnitId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 247
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "byteOrder": {
          "anyOf": [
            {
              "enum": ["big-endian", "little-endian", "word-swapped"]
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "registers": {
          "type": "object",
          "required": [
            "setpointCurrent",
            "enable",
            "currentL1",
            "currentL2",
            "currentL3",
            "power",
            "energy",
            "status"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/register"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "fn", "type", "scale", "access", "unit", "source"],
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "fn": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "type": {
          "anyOf": [
            {
              "enum": ["uint16", "int16", "uint32", "int32", "float32"]
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "access": {
          "anyOf": [
            {
              "enum": ["r", "rw"]
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "enum": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "loxone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functionBlock", "inputs", "outputs", "source"],
      "properties": {
        "functionBlock": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "inputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/mapping"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "outputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/mapping"
            },
            {
              "$ref": "#/$defs/todo"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^registers\\.[A-Za-z0-9]+$"
      }
    }
  }
}
